# backend
/data/
*.db
*.db-wal
*.db-shm
config.json
scheduler_state.json
__pycache__/
*.pyc
*.pyo

# frontend
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
web/next-env.d.ts
*.local

# development tools
.playwright-mcp/
.playwright-cli/
.idea/
.vscode/
*.swp
*.swo

# docs：技术文档随仓库走（docs/ 里有架构与改造说明）；
# 私密/临时的推演记录用 *.private.md 排除即可。
/docs/*.private.md

# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# 内嵌前端的单二进制产物
/artex
# 一键更新在可执行文件旁留下的中间产物（暂存件 / 备份 / 失败版本 / 升级标记）
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# JWT 签名密钥（运行时生成，存项目根，绝不提交）
/jwt.key

# Docker 部署生成的本地环境（含密码/密钥，不提交）
.env

# 调度器运行/模拟产生的事件日志（测试产物，不提交）
*-events.csv

# bench 基准测试相关（本地产物，不提交）
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2
# 迁移/改造过程中的本地备份（含数据库快照与源码备份，绝不提交）
/.backup-manual/
/.backup-*/
/.refs/
/.cache/

# 运行日志
*.log
*.log.*

# 本地代理配置（含节点/订阅信息）
.clash-artex.yaml

# 本地运维脚本（内含登录凭据 / 本机代理探测逻辑，不上传）
/vpn.sh
/.github/workflows/
